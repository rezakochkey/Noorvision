<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="NOORVISION Bridge" android:textSize="28sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="MVP — ChatGPT به‌عنوان مغز، Android به‌عنوان اجراکننده" android:textSize="16sp" />
        <Button android:id="@+id/openAccessibility" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="فعال‌سازی Accessibility" />
        <Button android:id="@+id/openCamera" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="تست: بازکردن دوربین" />
        <Button android:id="@+id/goHome" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="تست: رفتن به Home" />
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="وضعیت: آماده" />
    </LinearLayout>
</ScrollView>
